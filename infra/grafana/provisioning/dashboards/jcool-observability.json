          "legendFormat": "{{breaker}} / {{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cache rebuild duration p95 / p99 (5m)",
      "description": "Measured while the single-flight lock is held, so this is the number the lease has to stay ahead of: once p99 approaches CACHE_LOCK_LEASE_MS, holders start losing the lock mid-rebuild and the herd comes back.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 63 },
      "id": 33,
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(cache_rebuild_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(cache_rebuild_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cache stampede lock outcomes (5m)",
      "description": "lock_wait is the protection working — a caller parked behind the one rebuild. lock_timeout is the one path where it does not hold: the waiter gave up and read through, so a hot key costs one Postgres query per waiter after all.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 63 },
      "id": 34,
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (result) (rate(catalog_cache_operations_total{result=~\"lock_wait|lock_timeout|rebuild|store_rejected|error_fallthrough\"}[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate-limit rejections by tier / route (5m)",
      "description": "The tier is what makes a 429 spike readable: default and account are anonymous flooding or one NAT'd office, user is a single authenticated account misbehaving.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
