    {
      "type": "timeseries",
      "title": "Circuit breaker state (0 closed · 1 half-open · 2 open)",
      "description": "max across replicas: breaker state is per-instance and in-memory, so replicas legitimately disagree and one of them refusing calls is already the incident. A bad API key never shows here — a 4xx is the provider answering, and is deliberately not counted as its fault.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 55 },
      "id": 31,
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20, "lineWidth": 2 },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "closed", "color": "green", "index": 0 }, "1": { "text": "half-open", "color": "yellow", "index": 1 }, "2": { "text": "open", "color": "red", "index": 2 } } }
          ]
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (breaker) (circuit_breaker_state)",
          "legendFormat": "{{breaker}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Circuit breaker calls by result (5m)",
      "description": "rejected are calls the downstream never saw. A rising rejected rate with no failures is the breaker doing its job, not a new outage. success means the downstream answered — including a 4xx the caller disowned, which is not a business success.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 55 },
      "id": 32,
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } },
