{
  "name": "@jcool/messaging",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Transactional outbox, inbox, BullMQ relay, consumers, dead letters and replay, shared by every service that publishes or consumes events",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./outbox-port": {
      "types": "./dist/outbox-port.d.ts",
      "default": "./dist/outbox-port.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "arch:check": "depcruise --config .dependency-cruiser.cjs src",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@jcool/id-codec": "workspace:*",
    "@jcool/kernel": "workspace:*",
    "@jcool/metrics-port": "workspace:*",
    "@jcool/platform": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@opentelemetry/api": "^1.9.1",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "nestjs-cls": "^6.2.2",
    "nestjs-pino": "^4.6.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jcool/testing": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@swc/core": "^1.16.13",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "bullmq": "^6.3.11",
    "dependency-cruiser": "^18.5.0",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.13.0",
    "ioredis": "^6.0.0",
    "nestjs-cls": "^6.2.2",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "prettier": "^3.9.9",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^5.0.3"
  }
}
