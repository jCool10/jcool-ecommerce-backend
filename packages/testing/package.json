{
  "name": "@jcool/testing",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Test doubles shared by every app's specs, consumed as TypeScript source by the test runner",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "arch:check": "depcruise --config .dependency-cruiser.cjs src",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@jcool/metrics-port": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/config": "^4.0.4",
    "nestjs-pino": "^4.6.1",
    "vitest": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/config": "^4.0.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "nestjs-pino": "^4.6.1",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
