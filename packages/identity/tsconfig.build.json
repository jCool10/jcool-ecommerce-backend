{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    // The app ships through nest build, whose SWC defaults emit assignment, not [[Define]], fields.
    "useDefineForClassFields": false,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts"],
  "references": [{ "path": "../kernel/tsconfig.build.json" }]
}
