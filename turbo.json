{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".prettierrc"],
  "futureFlags": {
    "watchUsingTaskInputs": true
  },
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint:check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "arch:check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["TESTCONTAINERS_*", "E2E_WORKERS", "DOCKER_*"]
    },
    "test:system": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["TESTCONTAINERS_*", "DOCKER_*"]
    }
  }
}
