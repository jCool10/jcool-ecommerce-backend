# Copy to .env.user and adjust. `.env.user` is gitignored — never commit real secrets.
# This is user-service's file. commerce-core has its own (.env.example → .env), and the two
# deliberately overlap only on REDIS_URL and JWT_ES256_PUBLIC_KEY: those are the entire interface.
# Missing/invalid required vars crash the app at startup (libs/config/src/env.validation.ts,
# UserEnvironmentVariables).

# App
NODE_ENV=development
# 3001, not 3000: commerce-core owns that port and both run at once.
PORT=3001
SWAGGER_ENABLED=true

# --- Observability ---
LOG_LEVEL=info
# Bearer token guarding GET /metrics (min 16 chars). Prometheus scrapes this service as the
# `jcool-user` job — the identity clock and auth-epoch alerts are fed from here and nowhere else.
# Both jobs read ONE credentials file, so this must be the same value as commerce-core's or that
# job scrapes nothing (a wrong bearer gets 404, not 401 — the target just looks empty).
# METRICS_TOKEN=
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=jcool-user
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SENTRY_DSN=

# --- Postgres (its own instance, not a schema in commerce-core's) ---
# REQUIRED. Local `npm run start:dev:user` connects via the host-mapped port from docker-compose.
USER_DATABASE_URL=postgresql://jcool:jcool_dev_pw@localhost:5434/jcool_user?schema=public
# Where `npm run db:migrate:prod:user` looks for this service's migration .sql files. Leave unset
# wherever the repo tree is present; the container image sets it to /app/migrations/user.
# USER_MIGRATIONS_DIR=apps/user/migrations
# DB_POOL_MAX=10
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# DB_POOL_IDLE_TIMEOUT_MS=10000

# --- Node-id lease (a THIRD Postgres, holding only `node_leases`) ---
# REQUIRED. Every id this service mints carries a 10-bit node id, and two processes minting under the
# same one produce colliding ids. The lease is what hands each process a distinct id and takes it
# back: a process that cannot renew stops minting and exits.
# A separate instance on purpose — the lease has to stay writable exactly when USER_DATABASE_URL is
# the thing having trouble, and it is the one piece of state a future second issuer would share.
IDENTITY_LEASE_DATABASE_URL=postgresql://jcool:jcool_dev_pw@localhost:5435/jcool_leases?schema=public
# REQUIRED. Which pool to lease from. Must name a pool in ID_SERVICE_POOLS — a typo is refused at
# boot rather than silently seeding a pool of its own.
IDENTITY_LEASE_SERVICE=user
# Pools and their sizes, `name:size` comma-separated. Size caps concurrent replicas of that service;
# 1023 is the maximum (node 1023 is held back for the single in-process writer that cannot lease).
# Shrinking a pool stops handing out the nodes above the new ceiling; it does not evict a replica
# already holding one — that one keeps minting until it shuts down.
# ID_SERVICE_POOLS=user:1023,scripts:1023
# Seconds before an unrenewed lease is reclaimable. Renewal runs three times per TTL, so this is also
# how long a stalled process keeps minting before it fences itself.
# IDENTITY_LEASE_TTL_SECONDS=30
# Clock-skew allowance between holders, in ms (min 1000). Raise it if hosts are not NTP-synced; never
# lower it — too small a value lets a new holder mint timestamps the previous one already used.
# IDENTITY_LEASE_SKEW_MS=5000
# Where `npm run db:migrate:prod:leases` looks for the lease migrations. Leave unset wherever the repo
# tree is present; the container image sets it to /app/migrations/leases.
# LEASE_MIGRATIONS_DIR=libs/identity/src/lease/migrations

# --- Redis (SHARED with commerce-core) ---
# REQUIRED. The one piece of infrastructure both services touch: this service writes
# `auth:epoch:{sub}` and `auth:denylist:{jti}`, commerce-core only reads them. Everything else each
# service keeps under its own prefix.
REDIS_URL=redis://localhost:6380

# --- Auth (this service is the only issuer) ---
# BOTH keys are REQUIRED here. Left unset on purpose: a private key committed to a public repo mints
# valid tokens for anyone who reads it.
#   openssl ecparam -name prime256v1 -genkey -noout -out jwt-es256.key
#   openssl ec -in jwt-es256.key -pubout -out jwt-es256.pub
#   base64 < jwt-es256.key | tr -d '\n'   # JWT_ES256_PRIVATE_KEY
#   base64 < jwt-es256.pub | tr -d '\n'   # JWT_ES256_PUBLIC_KEY
# commerce-core gets the public half alone — it verifies and never issues.
# JWT_ES256_PRIVATE_KEY=
# JWT_ES256_PUBLIC_KEY=
# `kid` stamped on every token. Must match commerce-core's, or every token it verifies is rejected.
# JWT_KEY_ID=v1
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
# How long Redis keeps a projected session epoch (auth:epoch:{sub}). Must stay >= REFRESH_TOKEN_TTL:
# verification fails closed on a missing key, so a session must never outlive its own projection —
# and it is commerce-core, not this service, that eats the 401.
# AUTH_EPOCH_REDIS_TTL=7d
# REQUIRED. HMAC key behind the routing bucket in every user id, so it is NOT rotatable: a new key
# routes every existing account to a shard that does not hold its rows. Treat it as permanent and
# back it up like the database. Min 32 chars, but length is not entropy — generate per environment:
#   openssl rand -base64 48
# The first boot pins this key's fingerprint in USER_DATABASE_URL's database and every later boot
# must match it. The pin travels with a backup.
# IDENTITY_BUCKET_KEY=

# argon2id cost params. Optional — OWASP-minimum defaults apply when omitted
# (memory 19456 KiB ≈ 19 MiB, time 2, parallelism 1). Raise if login stays fast.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Hardening (all optional) ---
# SHUTDOWN_GRACE_PERIOD_MS=0
THROTTLE_ENABLED=true
# COOKIE_SECURE=false
# The refresh cookie is scoped path=/auth on THIS origin. A browser client therefore talks to two
# origins, and both need to be in each service's allow-list.
# CORS_ORIGINS=
# TRUST_PROXY=1

# --- Email verification / password reset ---
# Public base URL used to build links in outbound email. Defaults to http://localhost:3000 — set it
# to whatever origin serves /auth once the two services sit behind different hostnames.
# APP_PUBLIC_URL=http://localhost:3001
EMAIL_VERIFICATION_TTL=24h
# AUTH_REQUIRE_VERIFIED_EMAIL=false
PASSWORD_RESET_TTL=1h

# --- Mail ---
# Same switch as commerce-core's: set it and mail is sent, leave it unset and mail is written to the
# log (envelope only). REQUIRED in production. Both services send mail and both need this.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@jcool.local
# MAIL_TIMEOUT_MS=10000

# --- Retention sweeps (this service registers exactly three) ---
# `auth-tokens:email-verification`, `auth-tokens:password-reset`, `auth-tokens:refresh`. The other
# five belong to commerce-core, which has the tables for them.
# RETENTION_ENABLED=true
# RETENTION_INTERVAL_MS=3600000
# RETENTION_BATCH_SIZE=500
# RETENTION_SWEEP_TIMEOUT_MS=30000
# Days past expiry (or past being spent) before a single-use token is collected. Default 7 (min 0).
# RETENTION_AUTH_TOKEN_GRACE_DAYS=7
# Days a REVOKED refresh token is kept — an order of magnitude longer, enforced at min 30. Expiry is
# age; revocation is evidence: the row is what turns a replayed refresh token into a detected reuse.
# RETENTION_REFRESH_TOKEN_GRACE_DAYS=30

# ============================================================================
# Deploying this service
# ============================================================================
# One image, two commands. The user service's entry point is
#   node --import ./dist/apps/user/src/instrumentation.js dist/apps/user/src/main.js
# and its schema is TWO separate release commands — its own tables and the lease table live in
# different databases:
#   npm run db:migrate:prod:user
#   npm run db:migrate:prod:leases
#
# --- Required: refuses to boot without these ---
#   NODE_ENV=production
#   USER_DATABASE_URL        SECRET — its own managed Postgres, not commerce-core's
#   IDENTITY_LEASE_DATABASE_URL
#                            SECRET — a third Postgres, holding only `node_leases`. Shared by every
#                            replica; that sharing is the point
#   IDENTITY_LEASE_SERVICE=user
#   REDIS_URL                SECRET — the same instance commerce-core uses
#   JWT_ES256_PRIVATE_KEY    SECRET — this service is the only holder
#   JWT_ES256_PUBLIC_KEY     base64 PEM, also given to commerce-core
#   IDENTITY_BUCKET_KEY      SECRET — >=32 chars and PERMANENT; pinned in the database at first boot
#
# --- Scaling ---
# Replicas are safe: each one leases its own node id and a process that loses its lease answers 503
# on anything that mints and then exits, so the orchestrator replaces it. Two things follow:
#   * ID_SERVICE_POOLS must allow at least as many nodes as the largest replica count
#   * the platform's readiness probe must be GET /health/ready — that is what turns a fenced process
#     into a rolled instance instead of one serving 503s
#
# --- Cutover note ---
# The refresh cookie is path=/auth on whichever origin issued it. Moving /auth to this service's
# origin invalidates every session that existed before the switch: everyone logs in once more.
