# Copy to .env and adjust. `.env` is gitignored — never commit real secrets.
# Missing/invalid required vars crash the app at startup (fail-fast, see src/shared/config/env.validation.ts).

# App
NODE_ENV=development
PORT=3000

# Swagger (used from Phase 4). Accepts "true" / "false"; defaults to true when omitted.
SWAGGER_ENABLED=true

# --- Observability (logging + metrics) ---
# pino log level: trace|debug|info|warn|error. Defaults to debug in dev, info in prod.
LOG_LEVEL=info
# Bearer token guarding GET /metrics (min 16 chars). Unset → open in dev, hidden in prod.
# Prometheus scrapes with this token; a missing/wrong token gets 404 (not 401).
# Left unset on purpose: generate a real one for any shared/prod env (e.g. `openssl rand -hex 24`).
# Shipping a default here would be a known, valid token that opens /metrics on copy-paste.
# METRICS_TOKEN=

# --- Distributed tracing (OpenTelemetry, Phase 3) ---
# OFF by default. The OTel SDK (src/instrumentation.ts, loaded via `node --import`) starts
# only when this is "true" — so unit/e2e and plain local dev never need a running Collector.
# To trace locally: bring up the Collector+Jaeger stack (Phase 5), then run the built app:
#   npm run build && OTEL_ENABLED=true npm run start:prod
# In the observability compose profile the `app` service also reads this from .env; set it "true"
# to trace the containerized app (the OTLP endpoint is forced to the collector by compose).
# OTEL_ENABLED=false
# service.name stamped on every span (defaults to jcool-api).
# OTEL_SERVICE_NAME=jcool-api
# OTLP/HTTP base endpoint of the Collector (the /v1/traces path is appended). The Collector,
# not the app, forwards to Jaeger and redacts PII. Defaults to http://localhost:4318.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Error tracking (Sentry, Phase 4) ---
# OFF by default. Sentry initializes (src/instrumentation.ts) only when SENTRY_DSN is set — so
# unit/e2e and plain local dev capture nothing and captureException is a silent no-op. Set a real
# DSN (from your Sentry project) to send 5xx errors, each tagged with requestId + traceId + route.
# Sentry reuses the OTel SDK above (skipOpenTelemetrySetup) — no double init. Keep the DSN in a
# secret store for shared/prod, never committed.
# SENTRY_DSN=
# Fraction (0–1) of transactions sampled for Sentry PERFORMANCE tracing. Leave 0/unset for
# error-only (the default): an explicit positive value also emits perf spans to Sentry.
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Docker Compose infra (Phase 2) ---
# Consumed by docker-compose.yml. Deterministic host ports (5433/6380) avoid
# clashes with any host-installed Postgres/Redis (plan phase-02 / process-management rule).
# These are LOCAL DEV DEFAULTS, not production secrets.
POSTGRES_USER=jcool
POSTGRES_PASSWORD=jcool_dev_pw
POSTGRES_DB=jcool_ecommerce
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
SEARCH_HOST_PORT=7700
# Meilisearch master key. Blank runs the engine keyless, which its development mode allows and is
# fine for a local index rebuildable from Postgres. Set one (>=16 chars) for anything shared, and
# mirror it into SEARCH_API_KEY below so the app authenticates.
SEARCH_MASTER_KEY=

# --- Docker Compose observability profile (Phase 5) ---
# Brought up with: docker compose --profile observability up -d
# (adds otel-collector + jaeger + prometheus + grafana; UIs bind to 127.0.0.1:
#  Prometheus 9090, Grafana 3001, Jaeger 16686.)
# Grafana admin password (LOCAL DEV DEFAULT; change for anything shared).
GRAFANA_ADMIN_PASSWORD=admin
# Prometheus scrapes the app's guarded /metrics with a Bearer token read from a mounted file:
#   infra/prometheus/secrets/metrics-token  (gitignored; copy from metrics-token.example).
# Its contents MUST equal METRICS_TOKEN above, or scrapes get 404 and the target shows DOWN.

# Postgres — used from Phase 3. Local `npm run start:dev` connects via the host-mapped port.
# (Inside the compose network the `app` service targets postgres:5432 — set in docker-compose.yml.)
DATABASE_URL=postgresql://jcool:jcool_dev_pw@localhost:5433/jcool_ecommerce?schema=public
# App-side pg pool bounds (all optional). Cap backend connections so a spike can't
# exhaust Postgres; connection timeout is finite (5000ms) instead of pg's 0=wait-forever
# so a saturated pool fails fast. Leave unset to use the defaults (10 / 5000 / 10000).
# DB_POOL_MAX=10
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# DB_POOL_IDLE_TIMEOUT_MS=10000

# Redis — used from Phase 4. Local dev connects via the host-mapped port.
REDIS_URL=redis://localhost:6380

# BullMQ key prefix; namespaces every queue key so one Redis can serve several
# environments. Changing it between deploys orphans everything under the old
# prefix — in-flight jobs become invisible to the new workers.
# QUEUE_PREFIX=bull

# Domain-events worker: applies published events, deduped through the inbox table so a redelivery
# has no second effect. On by default. Set to "false" to leave jobs waiting in Redis (no TTL)
# instead — nothing is lost, it just is not applied until a worker runs.
# QUEUE_WORKER_ENABLED=true
# Jobs applied in parallel by one worker. Each holds a pg connection for its whole transaction, so
# it competes with the HTTP path for DB_POOL_MAX — size the two together.
# QUEUE_WORKER_CONCURRENCY=5

# Retry budget for a failing consume, the first delivery included (1-10). When it runs out — or the
# handler raises a permanent error, such as an unparseable envelope or an event type nothing is
# registered for — the message moves to the `domain-events-dlq` queue instead of being retried or
# dropped. Replay it with `npm run queue:replay-dlq`. Default 8, which spans about two minutes: the
# handlers that call the payment gateway now give up on a call in seconds rather than waiting out
# the provider SDK, so the ladder has to be long enough to outlast a gateway outage on its own.
# QUEUE_CONSUMER_ATTEMPTS=8
# First retry delay in ms (100-60000); each further retry doubles it. 1s through 64s at the defaults.
# QUEUE_CONSUMER_BACKOFF_MS=1000

# Outbox relay: moves committed outbox rows onto the queue (poll -> publish -> mark published,
# all in one transaction). Safe to leave on in every replica — SKIP LOCKED gives each one a
# disjoint batch, so no leader election is needed.
# Kill-switch; on by default. Off leaves rows unpublished, never lost.
# OUTBOX_RELAY_ENABLED=true
# How often the relay polls, in ms (min 100). Default 1000 — roughly the added latency between
# committing an event and it reaching a consumer.
# OUTBOX_POLL_MS=1000
# Rows per tick (1-1000). Default 100. Also caps how long one transaction holds its row locks,
# since the publish runs inside it.
# OUTBOX_BATCH_SIZE=100

# --- Auth / Week 2 ---
# JWT_ACCESS_SECRET is REQUIRED (app fails to boot without it). Generate a long
# random value, e.g. `openssl rand -base64 48`. Never commit the real secret.
JWT_ACCESS_SECRET=dev-only-change-me-please-use-openssl-rand-base64-48
# Token lifetimes (string form). Optional — these defaults apply when omitted.
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
# IDENTITY_BUCKET_KEY is REQUIRED (app fails to boot without it). It is the HMAC key behind the
# routing bucket baked into every user id, so it is NOT a rotatable secret: rotating it routes every
# existing account to a shard that does not hold its rows, and the old buckets cannot be recomputed.
# Treat it as PERMANENT and back it up with the same rank as the database.
# Left unset on purpose — a value committed here would be a git-public, unrotatable key that turns
# every published user id into an offline email-confirmation oracle on `cp .env.example .env`.
# Generate one per environment with a CSPRNG and keep it in the secret manager:
#   openssl rand -base64 48
# Minimum 32 chars, but length is not entropy — a long passphrase is brute-forceable from a handful
# of self-registered (email, bucket) pairs. Use the generator, not a memorable string.
# There is no fingerprint var to set: the first boot pins this key's fingerprint in the database and
# every later boot is refused unless the key still matches it. That pin travels with a DB backup, so
# a restore into an environment holding a different key is stopped rather than silently misrouted —
# but it also records whatever key boots first, so verify the pinned fingerprint once (see README).
# IDENTITY_BUCKET_KEY=

# argon2id cost params. Optional — OWASP-minimum defaults apply when omitted
# (memory 19456 KiB ≈ 19 MiB, time 2, parallelism 1). Raise if login stays fast.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Hardening (all optional) ---
# Grace period (ms) the app keeps returning /health/ready 503 after SIGTERM before the HTTP
# server closes, so a load balancer drains this instance first (Phase 5). Default 0 = shut down
# immediately (tests/dev); set a few seconds (e.g. 5000) under an orchestrator to observe the drain.
# SHUTDOWN_GRACE_PERIOD_MS=0
# Rate limiting kill-switch. Accepts "true"/"false"; on by default.
THROTTLE_ENABLED=true
# Stock-reservation locking strategy: "pessimistic" (SELECT ... FOR UPDATE, default)
# or "optimistic" (version CAS + bounded retry). Both uphold the "never oversell" invariant.
# INVENTORY_LOCK_STRATEGY=pessimistic
# How far ahead a HELD reservation stamps expires_at (duration form: 15m, 1h, ...). Default 15m.
# Read by the reservation expiry sweep below, which is what actually frees a lapsed hold.
# INVENTORY_RESERVATION_TTL=15m
# Optimistic strategy only: retries after losing a version CAS before returning 409 (0 = never
# retry). A genuine shortfall never retries. Default 3.
# INVENTORY_OPTIMISTIC_MAX_RETRIES=3
# Base backoff in ms between optimistic retries (grows 2^attempt, plus random jitter). Default 20.
# INVENTORY_OPTIMISTIC_BACKOFF_MS=20
# `Secure` flag on auth cookies. On by default in production only; set "true" when
# terminating TLS at a proxy in staging so cookies still get the Secure attribute.
# COOKIE_SECURE=false
# CORS allow-list, comma-separated (e.g. https://app.example.com,https://admin.example.com).
# Empty/omitted = CORS disabled (same-origin only), the safe default for a same-site SPA.
# CORS_ORIGINS=
# Trust a reverse proxy so req.ip is the real client IP (rate-limiting + audit key on it).
# REQUIRED when deployed behind nginx/ALB/Cloudflare, else all clients share the proxy IP
# and one bucket locks out the cluster. Off by default (a direct deploy can't be spoofed via
# X-Forwarded-For). Set a hop count ("1" = one proxy) or a subnet/CSV; avoid "true" in prod.
# TRUST_PROXY=1

# --- Email verification (all optional) ---
# Public base URL used to build links in outbound email. Defaults to http://localhost:3000.
# APP_PUBLIC_URL=http://localhost:3000
# Lifetime of an email-verification token (duration form: 24h, 30m, 7d, ...).
EMAIL_VERIFICATION_TTL=24h
# Enforce a verified email before login is allowed. Off by default (tokens are
# still issued + redeemable); set "true" to refuse login for unverified accounts.
# AUTH_REQUIRE_VERIFIED_EMAIL=false

# --- Password reset (optional) ---
# Lifetime of a password-reset token (duration form: 1h, 30m, ...). Short by
# design — a reset token is a high-value credential. Defaults to 1h.
PASSWORD_RESET_TTL=1h

# --- Payment gateway (Week 6) ---
# Which gateway adapter the DI factory constructs. "stripe" (default, the coded path:
# HMAC-SHA256 webhook verify + timestamp tolerance) or "sepay" (interface-only seam).
# PAYMENT_PROVIDER=stripe
# Webhook signing secret (min 16 chars). REQUIRED when PAYMENT_PROVIDER=stripe — the Stripe
# adapter refuses to construct without it (fail-fast), so the app won't boot until it's set.
# Never commit the real value; generate one with `openssl rand -hex 24`.
PAYMENT_WEBHOOK_SECRET=whsec_dev_only_change_me_openssl_rand_hex_24
# Replay window (seconds) for the webhook timestamp tolerance. Default 300 (matches Stripe).
# PAYMENT_WEBHOOK_TOLERANCE_SEC=300
#
# Live Stripe API. Leave STRIPE_SECRET_KEY unset to keep the network-free coded path (createSession
# fabricates a cs_... handle — every test runs this way). Set it to a real test/live key to create
# genuine Checkout Sessions that a real checkout.session.completed webhook can settle end-to-end.
# Never commit a real key.
# STRIPE_SECRET_KEY=sk_test_xxx
# success_url is REQUIRED once STRIPE_SECRET_KEY is set (the adapter fail-fasts without it).
# {CHECKOUT_SESSION_ID} is Stripe's placeholder, expanded on redirect.
# STRIPE_SUCCESS_URL=http://localhost:3000/payments/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=http://localhost:3000/payments/cancel

# --- Order reconciliation sweep ---
# The polling counterpart to the payment webhook: asks the gateway about orders stuck in PENDING
# and settles them through the same idempotent finalize path, so a lost or delayed webhook still
# converges. Also expires orders nothing ever settles, releasing their stock holds.
# Kill-switch; on by default. Set false for a worker/one-off container that must not sweep.
# RECONCILE_ENABLED=true
# How often the sweep ticks, in ms (min 1000). Default 60000.
# RECONCILE_INTERVAL_MS=60000
# Orders per tick (1-500) — the cap on gateway round-trips per sweep. Default 50.
# RECONCILE_BATCH_SIZE=50
# Minimum age (s) before a PENDING order is swept; younger ones are still likely waiting on a
# webhook in flight, so polling them just burns a gateway call. Default 120.
# ORDER_STALE_THRESHOLD_SEC=120
# Age (s) after which an unsettled PENDING order is expired and its stock hold released. Default
# 900, matching INVENTORY_RESERVATION_TTL so an order never outlives the hold it depends on.
# ORDER_TTL_SEC=900

# --- Reservation expiry sweep ---
# The liveness backstop behind the reconciliation sweep: expires orders whose stock hold has lapsed,
# asking the payment gateway nothing. That is the point — it still frees stock while the gateway is
# unreachable, which is exactly when orders pile up. It cannot close the checkout session, so the
# grace below keeps it strictly behind the reconciliation sweep, which can.
# Kill-switch; on by default. Set false for a worker/one-off container that must not sweep.
# RESERVATION_SWEEP_ENABLED=true
# How often the sweep ticks, in ms (min 1000). Default 60000.
# RESERVATION_SWEEP_INTERVAL_MS=60000
# Reservation rows per tick (1-500); a multi-line order collapses to one order. Default 50.
# RESERVATION_SWEEP_BATCH_SIZE=50
# Extra age (s) past a hold's expires_at before this sweep claims the order. Default 900 — a full
# ORDER_TTL_SEC behind reconciliation, so an order is only expired here once that sweep has had many
# ticks to settle it properly.
# RESERVATION_SWEEP_GRACE_SEC=900

# --- Catalog cache (Redis, cache-aside) ---
# How long (s) a cached product list page / product detail is served without question — Catalog's
# fresh window on the stampede-protected path below. After it the entry is served stale while one
# rebuild runs behind it, so the upper bound on a missed invalidation is this plus
# CACHE_STALE_WINDOW_SEC plus CACHE_TTL_JITTER_SEC. Default 60 (min 1).
# Invalidation itself is not TTL-driven: every admin write bumps a generation counter that all
# catalog keys embed, so the next read misses and refills. Redis down → the cache layer falls
# through to Postgres; watch catalog_cache_operations_total{result="error"} for that, and
# result="store_rejected" for a Redis that reads but refuses writes. The rate-limit guard is a separate Redis
# dependency in front of every route, so a full outage still fails requests unless
# THROTTLE_ENABLED=false. Do not run this Redis with an allkeys-* maxmemory policy: evicting the
# TTL-less generation counter while data keys survive would re-expose invalidated entries.
# CATALOG_CACHE_TTL_SEC=60

# --- Stampede protection (stale-while-revalidate + single-flight rebuild) ---
# Windows for the cache path that survives a hot key expiring under load. An entry is served
# unquestioned for CACHE_SOFT_TTL_SEC, then served stale for CACHE_STALE_WINDOW_SEC while one
# rebuild runs behind it; past both it is gone and the next reader waits on Postgres. Turning SWR
# off means zeroing the stale window AND the jitter below — jitter also extends an entry past its
# fresh window, so a non-zero jitter alone still produces stale serves.
# CACHE_SOFT_TTL_SEC=60
# CACHE_STALE_WINDOW_SEC=30
# Random extra (0..N s) on each entry's expiry so a wave of keys written together — after a cold
# start or a generation bump — does not expire together and send one herd per wave. 0 disables it.
# CACHE_TTL_JITTER_SEC=10
# Lease on the rebuild lock: the ceiling on how long one crashed rebuilder blocks the next rebuild.
# Keep it above the p99 of cache_rebuild_duration_seconds — a lease that expires mid-rebuild lets a
# second rebuilder in, which is the herd this lock exists to stop.
# CACHE_LOCK_LEASE_MS=5000
# How long a reader that lost the lock waits for the winner's value before querying Postgres
# itself (counted as catalog_cache_operations_total{result="lock_timeout"}). 0 = never wait. This
# caps what single-flight can absorb: a rebuild slower than this times every waiter out and the
# herd arrives anyway. A waiter also stops early — without burning the budget — when the holder
# releases the lock without storing anything (an absent value, a failed rebuild, a refused write).
# CACHE_LOCK_WAIT_MS=500

# --- Catalog search (Meilisearch) ---
# OFF by default: the search index is derived from Postgres (the only source of truth) and is an
# extra read path, never a required one — so dev, unit tests and any boot without an engine work
# untouched. Turn it on once the engine is up (`docker compose up -d meilisearch`).
# SEARCH_ENABLED=false
# Engine base URL. Defaults to http://localhost:7700 — the host-mapped SEARCH_HOST_PORT above.
# Inside the compose network docker-compose.yml overrides this to http://meilisearch:7700.
# A blank value fails at boot rather than silently falling back.
# SEARCH_URL=http://localhost:7700
# Key the app sends to the engine (min 16 chars). Leave unset for a keyless local engine; where set
# it must equal SEARCH_MASTER_KEY above.
# SEARCH_API_KEY=

# --- Circuit breaker (calls that leave the process; currently the payment gateway) ---
# What it protects against is the gateway being SLOW, not the gateway erroring: every caller waiting
# out a timeout holds one of our request slots, so their outage becomes ours. Past the failure
# threshold the circuit opens, calls fail immediately (checkout answers 502, both sweeps retry on
# their next tick) and the downstream gets room to recover. State is per instance — each replica
# learns the gateway's health from its own traffic — so circuit_breaker_state can legitimately
# disagree across replicas.
# Kill-switch; on by default. Off passes every guarded call straight through to the downstream —
# including the timeout below, so a call then waits out the Stripe SDK's own 20s instead of 3s.
# BREAKER_ENABLED=true
# How long one call may run before it is abandoned and counted as a failure (min 100). Default 3000.
# Deliberately well below the Stripe SDK's own 20s timeout: without this a gateway that hangs rather
# than errors never trips anything — nothing fails, we simply stop having request slots. Note it
# abandons our WAIT; the request already on the wire keeps its socket until the SDK gives up.
# BREAKER_TIMEOUT_MS=3000
# Failure share within the rolling window that opens the circuit (1-99). Default 50. Capped below
# 100 because the comparison is strict: at 100 the circuit never opens, however many calls fail.
# Stripe 4xx answers are not counted at all — those are verdicts on one request, not on the gateway.
# BREAKER_ERROR_THRESHOLD_PCT=50
# How long calls fail fast before one trial call is let through (min 100). Default 10000 — long
# enough for a restart or failover on the far side, short enough that recovery is not felt as a
# longer outage than the fault itself.
# BREAKER_RESET_TIMEOUT_MS=10000
# The window the failure share is measured over — the breaker's memory (min 1000). Default 10000.
# Past it errors are forgotten, so a slow trickle of failures never accumulates into an open circuit.
# It is not cleared when the circuit closes: a failure just after recovery still sees the earlier
# ones and can re-open immediately, which is how a false recovery gets caught.
# BREAKER_ROLLING_WINDOW_MS=10000
# Calls the window must hold before the share means anything (min 1). Default 5, so one failure on a
# quiet route cannot read as 100%. The flip side: below this call rate the circuit never opens at
# all, and the timeout above is the only protection left.
# BREAKER_VOLUME_THRESHOLD=5
