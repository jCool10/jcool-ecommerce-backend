# Copy to .env and adjust. `.env` is gitignored — never commit real secrets.
# Missing/invalid required vars crash the app at startup (fail-fast, see src/shared/config/env.validation.ts).

# App
NODE_ENV=development
PORT=3000

# Swagger (used from Phase 4). Accepts "true" / "false"; defaults to true when omitted.
SWAGGER_ENABLED=true

# --- Observability (logging + metrics) ---
# pino log level: trace|debug|info|warn|error. Defaults to debug in dev, info in prod.
LOG_LEVEL=info
# Bearer token guarding GET /metrics (min 16 chars). Unset → open in dev, hidden in prod.
# Prometheus scrapes with this token; a missing/wrong token gets 404 (not 401).
# Left unset on purpose: generate a real one for any shared/prod env (e.g. `openssl rand -hex 24`).
# Shipping a default here would be a known, valid token that opens /metrics on copy-paste.
# METRICS_TOKEN=

# --- Distributed tracing (OpenTelemetry, Phase 3) ---
# OFF by default. The OTel SDK (src/instrumentation.ts, loaded via `node --import`) starts
# only when this is "true" — so unit/e2e and plain local dev never need a running Collector.
# To trace locally: bring up the Collector+Jaeger stack (Phase 5), then run the built app:
#   npm run build && OTEL_ENABLED=true npm run start:prod
# In the observability compose profile the `app` service also reads this from .env; set it "true"
# to trace the containerized app (the OTLP endpoint is forced to the collector by compose).
# OTEL_ENABLED=false
# service.name stamped on every span (defaults to jcool-api).
# OTEL_SERVICE_NAME=jcool-api
# OTLP/HTTP base endpoint of the Collector (the /v1/traces path is appended). The Collector,
# not the app, forwards to Jaeger and redacts PII. Defaults to http://localhost:4318.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Error tracking (Sentry, Phase 4) ---
# OFF by default. Sentry initializes (src/instrumentation.ts) only when SENTRY_DSN is set — so
# unit/e2e and plain local dev capture nothing and captureException is a silent no-op. Set a real
# DSN (from your Sentry project) to send 5xx errors, each tagged with requestId + traceId + route.
# Sentry reuses the OTel SDK above (skipOpenTelemetrySetup) — no double init. Keep the DSN in a
# secret store for shared/prod, never committed.
# SENTRY_DSN=
# Fraction (0–1) of transactions sampled for Sentry PERFORMANCE tracing. Leave 0/unset for
# error-only (the default): an explicit positive value also emits perf spans to Sentry.
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Docker Compose infra (Phase 2) ---
# Consumed by docker-compose.yml. Deterministic host ports (5433/6380) avoid
# clashes with any host-installed Postgres/Redis (plan phase-02 / process-management rule).
# These are LOCAL DEV DEFAULTS, not production secrets.
POSTGRES_USER=jcool
POSTGRES_PASSWORD=jcool_dev_pw
POSTGRES_DB=jcool_ecommerce
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# --- Docker Compose observability profile (Phase 5) ---
# Brought up with: docker compose --profile observability up -d
# (adds otel-collector + jaeger + prometheus + grafana; UIs bind to 127.0.0.1:
#  Prometheus 9090, Grafana 3001, Jaeger 16686.)
# Grafana admin password (LOCAL DEV DEFAULT; change for anything shared).
GRAFANA_ADMIN_PASSWORD=admin
# Prometheus scrapes the app's guarded /metrics with a Bearer token read from a mounted file:
#   infra/prometheus/secrets/metrics-token  (gitignored; copy from metrics-token.example).
# Its contents MUST equal METRICS_TOKEN above, or scrapes get 404 and the target shows DOWN.

# Postgres — used from Phase 3. Local `npm run start:dev` connects via the host-mapped port.
# (Inside the compose network the `app` service targets postgres:5432 — set in docker-compose.yml.)
DATABASE_URL=postgresql://jcool:jcool_dev_pw@localhost:5433/jcool_ecommerce?schema=public

# Redis — used from Phase 4. Local dev connects via the host-mapped port.
REDIS_URL=redis://localhost:6380

# --- Auth / Week 2 ---
# JWT_ACCESS_SECRET is REQUIRED (app fails to boot without it). Generate a long
# random value, e.g. `openssl rand -base64 48`. Never commit the real secret.
JWT_ACCESS_SECRET=dev-only-change-me-please-use-openssl-rand-base64-48
# Token lifetimes (string form). Optional — these defaults apply when omitted.
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
# argon2id cost params. Optional — OWASP-minimum defaults apply when omitted
# (memory 19456 KiB ≈ 19 MiB, time 2, parallelism 1). Raise if login stays fast.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Hardening (all optional) ---
# Grace period (ms) the app keeps returning /health/ready 503 after SIGTERM before the HTTP
# server closes, so a load balancer drains this instance first (Phase 5). Default 0 = shut down
# immediately (tests/dev); set a few seconds (e.g. 5000) under an orchestrator to observe the drain.
# SHUTDOWN_GRACE_PERIOD_MS=0
# Rate limiting kill-switch. Accepts "true"/"false"; on by default.
THROTTLE_ENABLED=true
# Stock-reservation locking strategy: "pessimistic" (SELECT ... FOR UPDATE, default)
# or "optimistic" (version CAS + bounded retry). Both uphold the "never oversell" invariant.
# INVENTORY_LOCK_STRATEGY=pessimistic
# How far ahead a HELD reservation stamps expires_at (duration form: 15m, 1h, ...). Default 15m.
# Only the timestamp is written today; nothing sweeps expired holds yet.
# INVENTORY_RESERVATION_TTL=15m
# Optimistic strategy only: retries after losing a version CAS before returning 409 (0 = never
# retry). A genuine shortfall never retries. Default 3.
# INVENTORY_OPTIMISTIC_MAX_RETRIES=3
# Base backoff in ms between optimistic retries (grows 2^attempt, plus random jitter). Default 20.
# INVENTORY_OPTIMISTIC_BACKOFF_MS=20
# `Secure` flag on auth cookies. On by default in production only; set "true" when
# terminating TLS at a proxy in staging so cookies still get the Secure attribute.
# COOKIE_SECURE=false
# CORS allow-list, comma-separated (e.g. https://app.example.com,https://admin.example.com).
# Empty/omitted = CORS disabled (same-origin only), the safe default for a same-site SPA.
# CORS_ORIGINS=
# Trust a reverse proxy so req.ip is the real client IP (rate-limiting + audit key on it).
# REQUIRED when deployed behind nginx/ALB/Cloudflare, else all clients share the proxy IP
# and one bucket locks out the cluster. Off by default (a direct deploy can't be spoofed via
# X-Forwarded-For). Set a hop count ("1" = one proxy) or a subnet/CSV; avoid "true" in prod.
# TRUST_PROXY=1

# --- Email verification (all optional) ---
# Public base URL used to build links in outbound email. Defaults to http://localhost:3000.
# APP_PUBLIC_URL=http://localhost:3000
# Lifetime of an email-verification token (duration form: 24h, 30m, 7d, ...).
EMAIL_VERIFICATION_TTL=24h
# Enforce a verified email before login is allowed. Off by default (tokens are
# still issued + redeemable); set "true" to refuse login for unverified accounts.
# AUTH_REQUIRE_VERIFIED_EMAIL=false

# --- Password reset (optional) ---
# Lifetime of a password-reset token (duration form: 1h, 30m, ...). Short by
# design — a reset token is a high-value credential. Defaults to 1h.
PASSWORD_RESET_TTL=1h
