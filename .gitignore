# Dependencies
node_modules/

# Build output
dist/
build/
.turbo/
*.tsbuildinfo

# Coverage / test artifacts
coverage/
.nyc_output/

# Environment (never commit real secrets; .env.example is the committed template)
.env
.env.*
!.env.example

# Local observability secret (Phase 5): the real Prometheus scrape token, mounted into the
# Prometheus container. Must match the app's METRICS_TOKEN. Only the .example template is committed.
infra/prometheus/secrets/metrics-token

# Logs
*.log
npm-debug.log*
logs

# Editor / OS
.DS_Store
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


!README.md

# Working records, not documentation authority: plans, phase files and audit reports are
# stateful and local. Committed docs live in docs/ and are indexed by docs/README.md.
plans/
docs/*.html
docs/interview-*
docs/test-dedup-backlog.md

.agentkit/
.claude/
*.txt

bruno/