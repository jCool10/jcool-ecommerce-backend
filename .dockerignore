# Keep the build context small and never leak secrets into the image.

node_modules
npm-debug.log*
dist
build
coverage
.nyc_output

.git
.gitignore

# Secrets: only the committed template is allowed in.
.env
.env.*
!.env.example

.DS_Store
.idea
.vscode
*.log

# Repo-only material not needed to build or run the app.
.claude
plans
docs
README.md
Dockerfile
.dockerignore
docker-compose.yml

# Local-stack material. `infra` matters most: it holds infra/prometheus/secrets/, which the
# builder's `COPY . .` would otherwise bake into a layer. Compose reaches these by bind mount
# from the host, so excluding them from the build context costs nothing.
infra
bruno
k6

# Not compiled into the image — the build compiles `apps` and `libs` only.
test
scripts
