# Keep the build context small and never leak secrets into the image.

**/node_modules
npm-debug.log*
**/dist
build
**/coverage
.nyc_output
**/.turbo

.git
.gitignore

# Secrets: only the committed template is allowed in.
**/.env
**/.env.*
!.env.example

.DS_Store
.idea
.vscode
*.log

# Repo-only material not needed to build or run the app.
.claude
.railway
plans
docs
README.md
Dockerfile
.dockerignore
docker-compose.yml

# Local-stack material. `infra` matters most: it holds infra/prometheus/secrets/, which the
# builder's `COPY . .` would otherwise bake into a layer. Compose reaches these by bind mount
# from the host, so excluding them from the build context costs nothing.
infra
bruno
k6

# Railway has no bind mounts: the prometheus, grafana, loki and elasticsearch images bake their config
# instead, so these files must be in the context. Last match wins, which is why the secrets directory
# is re-excluded below — it must stay out of every image, including the api's `COPY . .`.
!infra/prometheus/Dockerfile
!infra/prometheus/prometheus.railway.yml
!infra/prometheus/railway-entrypoint.sh
!infra/prometheus/rules
!infra/grafana/Dockerfile
!infra/grafana/provisioning
!infra/grafana/railway
!infra/loki/Dockerfile
!infra/loki/config.yaml
!infra/elasticsearch/Dockerfile
!infra/elasticsearch/elasticsearch.yml
!infra/elasticsearch/railway-entrypoint.sh
infra/prometheus/secrets

# Not compiled into the image — tsconfig.build.json already excludes both.
test
scripts
apps/*/test
apps/*/scripts
