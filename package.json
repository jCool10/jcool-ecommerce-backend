{
  "name": "jcool-ecommerce-backend-v2",
  "version": "1.0.0",
  "description": "Single-store e-commerce backend (NestJS modular monolith) — interview deep-dive playground",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --env-file-if-exists=.env --import ./dist/instrumentation.js dist/main",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "arch:check": "depcruise --config .dependency-cruiser.cjs src",
    "alerts:check": "promtool check rules infra/prometheus/rules/*.yml",
    "alerts:test": "promtool test rules infra/prometheus/tests/*.test.yml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./test/vitest-e2e.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/shared/infrastructure/database/migrate-cli.js",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/shared/infrastructure/database/seed.ts",
    "db:seed:perf": "tsx scripts/perf-seed.ts",
    "seed:users:bulk": "tsx scripts/seed-users-bulk.ts",
    "db:metrics:users": "tsx scripts/capture-db-metrics.ts",
    "identity:verify": "tsx scripts/verify-identity-buckets.ts",
    "queue:replay-dlq": "tsx src/shared/messaging/queue/replay-dlq.cli.ts",
    "queue:replay-dlq:prod": "node dist/shared/messaging/queue/replay-dlq.cli.js",
    "search:reindex": "tsx src/modules/catalog/infrastructure/search/reindex.ts",
    "search:reindex:prod": "node dist/modules/catalog/infrastructure/search/reindex.js",
    "storage:verify": "tsx src/shared/infrastructure/storage/verify-storage-orphans.cli.ts",
    "storage:verify:prod": "node dist/shared/infrastructure/storage/verify-storage-orphans.cli.js",
    "load:baseline": "k6 run k6/baseline.js",
    "load:register:write": "k6 run test/load/register-uniqueness/write-mix.js",
    "load:register:dup": "k6 run test/load/register-uniqueness/duplicate-mix.js",
    "load:cache-stampede": "OUT=${OUT_DIR:-plans/260911-0904-k6-performance-program/results/cache-stampede/${ARM:-protected}}; mkdir -p \"$OUT\" && k6 run --summary-export=\"$OUT/k6-summary.json\" test/load/cache-stampede/catalog-read.js",
    "load:breakpoint": "OUT=${OUT_DIR:-plans/260911-0904-k6-performance-program/results/breakpoint/${PROFILE:-read}}; mkdir -p \"$OUT\" && k6 run --summary-export=\"$OUT/k6-summary.json\" test/load/breakpoint/breakpoint.js",
    "load:sku-contention": "OUT=${OUT_DIR:-plans/260911-0904-k6-performance-program/results/inventory-contention/${MODE:-c1}/${STRATEGY:-pessimistic}/level-${RATE:-40}}; mkdir -p \"$OUT\" && k6 run --summary-export=\"$OUT/k6-summary.json\" test/load/inventory-contention/sku-contention.js",
    "load:public-read": "OUT=${OUT_DIR:-plans/260911-0904-k6-performance-program/results/public-read/${PROFILE:-steady}}; mkdir -p \"$OUT\" && k6 run --summary-export=\"$OUT/k6-summary.json\" test/load/public-read/read-profile.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/nestjs": "^10.73.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "meilisearch": "^0.60.0",
    "nestjs-cls": "^6.2.2",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^10.0.1",
    "opossum": "^10.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.1",
    "uuid": "^11.1.0"
  },
  "overrides": {
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@testcontainers/minio": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/opossum": "^8.1.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "chokidar": "^5.0.0",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.1.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "unplugin-swc": "^1.5.11",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  }
}
