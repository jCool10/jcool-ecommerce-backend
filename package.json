{
  "name": "jcool-ecommerce-backend-v2",
  "version": "1.0.0",
  "description": "Single-store e-commerce backend (NestJS modular monolith) — interview deep-dive playground",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @jcool/checkout-core --",
    "format": "prettier --write \"apps/*/src/**/*.ts\" \"apps/*/test/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "start": "npm run start -w @jcool/checkout-core --",
    "start:dev": "npm run start:dev -w @jcool/checkout-core --",
    "start:debug": "npm run start:debug -w @jcool/checkout-core --",
    "start:prod": "npm run start:prod -w @jcool/checkout-core --",
    "lint": "eslint \"apps/*/{src,scripts,test}/**/*.ts\" \"packages/*/src/**/*.ts\" --fix",
    "lint:check": "eslint \"apps/*/{src,scripts,test}/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "typecheck": "npm run typecheck --workspaces --if-present --",
    "arch:check": "depcruise --config .dependency-cruiser.cjs apps/checkout-core/src packages/*/src",
    "alerts:check": "promtool check rules infra/prometheus/rules/*.yml",
    "alerts:test": "promtool test rules infra/prometheus/tests/*.test.yml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "npm run test:e2e -w @jcool/checkout-core --",
    "db:generate": "npm run db:generate -w @jcool/checkout-core --",
    "db:migrate": "npm run db:migrate -w @jcool/checkout-core --",
    "db:migrate:prod": "npm run db:migrate:prod -w @jcool/checkout-core --",
    "db:studio": "npm run db:studio -w @jcool/checkout-core --",
    "db:seed": "npm run db:seed -w @jcool/checkout-core --",
    "db:seed:perf": "npm run db:seed:perf -w @jcool/checkout-core --",
    "seed:users:bulk": "npm run seed:users:bulk -w @jcool/checkout-core --",
    "db:metrics:users": "npm run db:metrics:users -w @jcool/checkout-core --",
    "identity:verify": "npm run identity:verify -w @jcool/checkout-core --",
    "queue:replay-dlq": "npm run queue:replay-dlq -w @jcool/checkout-core --",
    "queue:replay-dlq:prod": "npm run queue:replay-dlq:prod -w @jcool/checkout-core --",
    "search:reindex": "npm run search:reindex -w @jcool/checkout-core --",
    "search:reindex:prod": "npm run search:reindex:prod -w @jcool/checkout-core --",
    "storage:verify": "npm run storage:verify -w @jcool/checkout-core --",
    "storage:verify:prod": "npm run storage:verify:prod -w @jcool/checkout-core --",
    "dev:link-env": "[ ! -e apps/checkout-core/.env ] || [ -L apps/checkout-core/.env ] || { echo 'apps/checkout-core/.env is a regular file: merge it into the root .env and delete it' >&2; exit 1; }; ln -sfn ../../.env apps/checkout-core/.env",
    "load:baseline": "k6 run k6/baseline.js",
    "load:register:write": "k6 run test/load/register-uniqueness/write-mix.js",
    "load:register:dup": "k6 run test/load/register-uniqueness/duplicate-mix.js",
    "load:cache-stampede": "OUT=${OUT_DIR:-plans/260911-0904-k6-performance-program/results/cache-stampede/${ARM:-protected}}; mkdir -p \"$OUT\" && k6 run --summary-export=\"$OUT/k6-summary.json\" test/load/cache-stampede/catalog-read.js",
    "load:breakpoint": "OUT=${OUT_DIR:-plans/260911-0904-k6-performance-program/results/breakpoint/${PROFILE:-read}}; mkdir -p \"$OUT\" && k6 run --summary-export=\"$OUT/k6-summary.json\" test/load/breakpoint/breakpoint.js",
    "load:sku-contention": "OUT=${OUT_DIR:-plans/260911-0904-k6-performance-program/results/inventory-contention/${MODE:-c1}/${STRATEGY:-pessimistic}/level-${RATE:-40}}; mkdir -p \"$OUT\" && k6 run --summary-export=\"$OUT/k6-summary.json\" test/load/inventory-contention/sku-contention.js",
    "load:public-read": "OUT=${OUT_DIR:-plans/260911-0904-k6-performance-program/results/public-read/${PROFILE:-steady}}; mkdir -p \"$OUT\" && k6 run --summary-export=\"$OUT/k6-summary.json\" test/load/public-read/read-profile.js"
  },
  "overrides": {
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@testcontainers/minio": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/opossum": "^8.1.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "chokidar": "^5.0.0",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.1.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "unplugin-swc": "^1.5.11",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  }
}
