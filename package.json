{
  "name": "jcool-ecommerce-backend",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "typecheck": "turbo run typecheck",
    "arch:check": "turbo run arch:check",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:e2e": "turbo run test:e2e",
    "dev:link-env": "ln -sf ../../.env apps/api/.env",
    "format": "pnpm --filter @jcool/api format",
    "start": "pnpm --filter @jcool/api start",
    "start:dev": "pnpm --filter @jcool/api start:dev",
    "start:debug": "pnpm --filter @jcool/api start:debug",
    "start:prod": "pnpm --filter @jcool/api start:prod",
    "test:watch": "pnpm --filter @jcool/api test:watch",
    "test:debug": "pnpm --filter @jcool/api test:debug",
    "db:generate": "pnpm --filter @jcool/api db:generate",
    "db:migrate": "pnpm --filter @jcool/api db:migrate",
    "db:migrate:prod": "pnpm --filter @jcool/api db:migrate:prod",
    "db:studio": "pnpm --filter @jcool/api db:studio",
    "db:seed": "pnpm --filter @jcool/api db:seed",
    "db:seed:perf": "pnpm --filter @jcool/api db:seed:perf",
    "db:metrics:users": "pnpm --filter @jcool/api db:metrics:users",
    "seed:users:bulk": "pnpm --filter @jcool/api seed:users:bulk",
    "identity:verify": "pnpm --filter @jcool/api identity:verify",
    "queue:replay-dlq": "pnpm --filter @jcool/api queue:replay-dlq",
    "queue:replay-dlq:prod": "pnpm --filter @jcool/api queue:replay-dlq:prod",
    "search:reindex": "pnpm --filter @jcool/api search:reindex",
    "search:reindex:prod": "pnpm --filter @jcool/api search:reindex:prod",
    "storage:verify": "pnpm --filter @jcool/api storage:verify",
    "storage:verify:prod": "pnpm --filter @jcool/api storage:verify:prod",
    "alerts:check": "promtool check rules infra/prometheus/rules/*.yml",
    "alerts:test": "promtool test rules infra/prometheus/tests/*.test.yml",
    "load:baseline": "k6 run k6/baseline.js",
    "load:register:write": "k6 run test/load/register-uniqueness/write-mix.js",
    "load:register:dup": "k6 run test/load/register-uniqueness/duplicate-mix.js",
    "load:cache-stampede": "OUT=${OUT_DIR:-plans/260911-0904-k6-performance-program/results/cache-stampede/${ARM:-protected}}; mkdir -p \"$OUT\" && k6 run --summary-export=\"$OUT/k6-summary.json\" test/load/cache-stampede/catalog-read.js",
    "load:breakpoint": "OUT=${OUT_DIR:-plans/260911-0904-k6-performance-program/results/breakpoint/${PROFILE:-read}}; mkdir -p \"$OUT\" && k6 run --summary-export=\"$OUT/k6-summary.json\" test/load/breakpoint/breakpoint.js",
    "load:sku-contention": "OUT=${OUT_DIR:-plans/260911-0904-k6-performance-program/results/inventory-contention/${MODE:-c1}/${STRATEGY:-pessimistic}/level-${RATE:-40}}; mkdir -p \"$OUT\" && k6 run --summary-export=\"$OUT/k6-summary.json\" test/load/inventory-contention/sku-contention.js",
    "load:public-read": "OUT=${OUT_DIR:-plans/260911-0904-k6-performance-program/results/public-read/${PROFILE:-steady}}; mkdir -p \"$OUT\" && k6 run --summary-export=\"$OUT/k6-summary.json\" test/load/public-read/read-profile.js"
  },
  "devDependencies": {
    "railway": "^3.11.0",
    "turbo": "^2.10.13"
  }
}
