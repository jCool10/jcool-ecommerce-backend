# Key catalog only. The real file is $JCOOL_SECRETS_DIR/smtp.env (deploy/scripts/apply-secrets.sh).
# KEY=value per line, no quotes. Production refuses a loopback host.
# Gmail: an App Password (2-Step Verification on), spaces removed, and the @ of the user written as %40:
#   SMTP_URL=smtps://<user>%40gmail.com:<app-password>@smtp.gmail.com:465
# MAIL_FROM must be that same address: Gmail rewrites any other From to the signed-in account.
# Kept here rather than in deploy/apps because the repo is public.
SMTP_URL=
MAIL_FROM=
