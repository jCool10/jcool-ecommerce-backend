# Key catalog only. The real file is $JCOOL_SECRETS_DIR/search.env (deploy/scripts/apply-secrets.sh).
# KEY=value per line, no quotes. openssl rand -hex 32 each. ELASTIC_PASSWORD is elastic's bootstrap password;
# API_SEARCH_PASSWORD is jcool_api's, set by hand inside the engine (RUNBOOK "Rotate a password").
ELASTIC_PASSWORD=
API_SEARCH_PASSWORD=
