# Key catalog only. The real file is $JCOOL_SECRETS_DIR/postgres-credentials.env (deploy/scripts/apply-secrets.sh).
# KEY=value per line, no quotes. Passwords: openssl rand -hex 32 (hex, so they need no escaping in a URL).
# Read by the init script on an empty volume only: changing one later means ALTER ROLE first (RUNBOOK).
POSTGRES_PASSWORD=
API_DB_PASSWORD=
USERS_DB_PASSWORD=
INVENTORY_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
ORDER_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
