# Key catalog only. The real file is $JCOOL_SECRETS_DIR/user-service-keys.env (deploy/scripts/apply-secrets.sh).
# KEY=value per line, no quotes.
# JWT_ES256_PRIVATE_KEYS is kid:pem on one line with literal \n, e.g. for kid prod-1:
#   printf 'prod-1:'; openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | awk '{printf "%s\\n", $0}'
# CSRF_SECRET: openssl rand -hex 32.
JWT_ES256_ACTIVE_KID=
JWT_ES256_PRIVATE_KEYS=
CSRF_SECRET=
