# Key catalog only. The real file is $JCOOL_SECRETS_DIR/internal-tokens.env (deploy/scripts/apply-secrets.sh).
# KEY=value per line, no quotes. One token per caller and target: openssl rand -hex 32.
# A _PREVIOUS key is the rotation slot: leave it empty outside a rotation and apply-secrets.sh leaves it out.
API_TO_USER=
API_TO_USER_PREVIOUS=
INVENTORY_TO_USER=
INVENTORY_TO_USER_PREVIOUS=
ORDER_TO_USER=
ORDER_TO_USER_PREVIOUS=
ORDER_TO_API=
ORDER_TO_API_PREVIOUS=
ORDER_TO_INVENTORY=
ORDER_TO_INVENTORY_PREVIOUS=
ORDER_TO_PAYMENT=
ORDER_TO_PAYMENT_PREVIOUS=
