# Copy to apps/id-service/.env. Read by `pnpm dev`, `pnpm start` and `lease:lift-floors` on the host;
# compose's id-service sets its own and never reads this file.
NODE_ENV=development
# The gateway's internal load balancer dials it here once `pnpm dev:gateway` points it at the host.
PORT=3003
LOG_LEVEL=info

# compose's id-etcd, published on loopback.
ETCD_ENDPOINTS=http://localhost:2379
# ETCD_KEY_PREFIX=/jcool/id-service/

# Every restart under `pnpm dev` waits it out before the node is released.
SHUTDOWN_GRACE_PERIOD_MS=0
