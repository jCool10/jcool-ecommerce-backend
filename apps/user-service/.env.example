# Copy to apps/user-service/.env. Read by `pnpm start`, the scripts, and compose's `user-service`
# profile, which overrides the URLs below with in-network ones and runs it as production.
NODE_ENV=development
PORT=3002
LOG_LEVEL=info

# Its own database: compose's user-postgres, published on loopback.
DATABASE_URL=postgresql://users:users@localhost:5434/users
# The api's Redis. auth:epoch:* and auth:denylist:* are read there; it must run with AOF on.
REDIS_URL=redis://localhost:6380
# The gateway's internal load balancer, never a replica. Compose publishes it on loopback; in-network
# it is http://gateway:4000, which compose substitutes.
ID_SERVICE_URL=http://localhost:4000
# ID_SERVICE_TIMEOUT_MS=2000

# true writes the id layout pin on a database that holds no users yet.
IDENTITY_PIN_BOOTSTRAP=true

# ES256 signing keys as kid:pem, comma-separated; the PEM may carry literal \n. Generate one with
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | awk '{printf "%s\\n", $0}'
# JWT_ES256_PRIVATE_KEYS=dev-1:-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
JWT_ES256_ACTIVE_KID=dev-1
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=jcool-api
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d

# Keys the CSRF cookies are signed with: rotating it invalidates every one in circulation.
CSRF_SECRET=dev-only-change-me-please-use-openssl-rand-base64-48

# Bearer tokens for /internal/v1/*, one per calling service; each *_PREVIOUS is also accepted while
# rotating. INTERNAL_API_TOKEN is the api's (every route); the inventory-service's reads session epochs only.
INTERNAL_API_TOKEN=dev-only-internal-token-change-me-openssl-rand-hex-32
INTERNAL_CALLER_TOKEN_INVENTORY_SERVICE=dev-only-inventory-caller-token-change-me-openssl

SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@jcool.local
THROTTLE_ENABLED=true
