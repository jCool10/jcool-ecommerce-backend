{
  "name": "@jcool/user-service",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Owns users, sessions and every /auth route; signs ES256 access tokens and is the only writer of auth:* in Redis",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "arch:check": "depcruise --config .dependency-cruiser.cjs src scripts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./test/vitest-e2e.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/database/migrate-cli.js",
    "db:seed:perf-user": "tsx --env-file-if-exists=.env scripts/seed-perf-user.ts",
    "seed:users:bulk": "tsx --env-file-if-exists=.env scripts/seed-users-bulk.ts",
    "db:metrics:users": "tsx --env-file-if-exists=.env scripts/capture-db-metrics.ts",
    "identity:verify": "tsx --env-file-if-exists=.env scripts/verify-identity-buckets.ts",
    "epochs:prewarm": "tsx scripts/prewarm-epochs.ts"
  },
  "dependencies": {
    "@jcool/auth-verifier": "workspace:*",
    "@jcool/id-codec": "workspace:*",
    "@jcool/kernel": "workspace:*",
    "@jcool/metrics-port": "workspace:*",
    "@jcool/platform": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@sentry/nestjs": "^10.75.0",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-cls": "^6.3.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jcool/id-generator": "workspace:*",
    "@jcool/testing": "workspace:*",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.16.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "supertest": "^7.0.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1"
  }
}
