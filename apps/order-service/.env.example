# Copy to apps/order-service/.env. Read by `pnpm start` and the scripts; compose's order-service
# overrides the URLs below with in-network ones.
NODE_ENV=development
PORT=3006
LOG_LEVEL=info

# Its own database: compose's order-postgres, published on loopback.
DATABASE_URL=postgresql://order:order@localhost:5437/order
# DB_POOL_MAX=16
# The shared Redis: the payment-service publishes payment.authorized onto order-events there.
REDIS_URL=redis://localhost:6380
# Must equal the payment-service's, or this worker never sees its jobs.
# QUEUE_PREFIX=bull
# The gateway's internal load balancer, never a replica.
ID_SERVICE_URL=http://localhost:4000
# ID_SERVICE_TIMEOUT_MS=2000

# Access tokens come from the user-service.
AUTH_JWKS_URL=http://localhost:3002/.well-known/jwks.json
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=jcool-api

# Each <TARGET>_SERVICE_TOKEN must equal that service's INTERNAL_CALLER_TOKEN_ORDER_SERVICE.
USER_SERVICE_URL=http://localhost:3002
USER_SERVICE_TOKEN=dev-only-order-to-user-token-change-me-openssl
# The api's private address for cart lines and SKU views, never the gateway.
API_SERVICE_URL=http://localhost:3000
API_SERVICE_TOKEN=dev-only-order-to-api-token-change-me-openssl
# API_SERVICE_TIMEOUT_MS=2000
INVENTORY_SERVICE_URL=http://localhost:3004
INVENTORY_SERVICE_TOKEN=dev-only-order-to-inventory-token-change-me-openssl
PAYMENT_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_TOKEN=dev-only-order-to-payment-token-change-me-openssl

# Rules across services, which nothing checks at boot (RUNBOOK → Cross-service settings):
#   4 × payment-service PAYMENT_CAPTURE_TIMEOUT_MS + 1000 <= PAYMENT_COMMAND_TIMEOUT_MS (45000)
#   inventory-service INVENTORY_TRY_LOCK_TIMEOUT_MS < CHECKOUT_TRY_TIMEOUT_MS (3000)
#   ORDER_PAID_CONSUMER_ATTEMPTS and QUEUE_PREFIX equal to the payment-service's
#   SHUTDOWN_GRACE_PERIOD_MS + TEMPORAL_WORKER_SHUTDOWN_GRACE_MS + TEMPORAL_WORKER_SHUTDOWN_FORCE_MS
#     + 1000 + 2 × 5000 <= drainingSeconds × 1000 - 1000 (30 in .railway/railway.ts)
# PAYMENT_COMMAND_TIMEOUT_MS=45000
# CHECKOUT_TRY_TIMEOUT_MS=3000
# ORDER_PAID_CONSUMER_ATTEMPTS=15
# 0 unset; Railway sets 5000.
# SHUTDOWN_GRACE_PERIOD_MS=0
# TEMPORAL_WORKER_SHUTDOWN_GRACE_MS=4000
# TEMPORAL_WORKER_SHUTDOWN_FORCE_MS=4000

# Same namespace and task queue as before the move, so open workflows keep their worker.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=jcool
TEMPORAL_TASK_QUEUE=checkout-saga
# TEMPORAL_WORKER_ENABLED=true

# order.paid mail: compose's Mailpit.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@jcool.local

# OUTBOX_RELAY_ENABLED=true
# QUEUE_WORKER_ENABLED=true
# CHECKOUT_REAPER_ENABLED=true
# CHECKOUT_INVARIANT_ENABLED=true
# THROTTLE_ENABLED=true
# SWAGGER_ENABLED=true
