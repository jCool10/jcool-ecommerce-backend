{
  "name": "@jcool/payment-service",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Owns payment headers, attempts and Stripe webhooks; serves /internal/v1/payments and POST /webhooks/payment, and publishes payment.authorized to order-events",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --import ./dist/instrumentation.js dist/main.js",
    "dev": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "arch:check": "depcruise --config .dependency-cruiser.cjs src",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./test/vitest-e2e.config.mts",
    "test:e2e:cov": "sh ../../scripts/run-merged-coverage.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/database/migrate-cli.js"
  },
  "dependencies": {
    "@jcool/id-codec": "workspace:*",
    "@jcool/internal-contracts": "workspace:*",
    "@jcool/kernel": "workspace:*",
    "@jcool/messaging": "workspace:*",
    "@jcool/metrics-port": "workspace:*",
    "@jcool/platform": "workspace:*",
    "@nestjs/common": "^12.3.3",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/terminus": "^12.1.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.1",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@sentry/nestjs": "^11.11.0",
    "@willsoto/nestjs-prometheus": "^7.0.0",
    "bullmq": "^6.5.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-cls": "^7.0.2",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jcool/id-generator": "workspace:*",
    "@jcool/testing": "workspace:*",
    "@nestjs/testing": "^12.3.3",
    "@swc/core": "^1.16.21",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "testcontainers": "^12.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^1.5.11",
    "vitest": "^5.0.5"
  }
}
