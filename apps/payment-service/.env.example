# Copy to apps/payment-service/.env. Read by `pnpm start` and the scripts; compose's payment-service
# overrides the URLs below with in-network ones.
NODE_ENV=development
PORT=3005
LOG_LEVEL=info

# Its own database: compose's payment-postgres, published on loopback.
DATABASE_URL=postgresql://payment:payment@localhost:5436/payment
# The shared Redis: payment.authorized lands on the order-service's order-events queue.
REDIS_URL=redis://localhost:6380
# Must equal the order-service's, or the relay writes jobs its worker never sees.
# QUEUE_PREFIX=bull
# The gateway's internal load balancer, never a replica.
ID_SERVICE_URL=http://localhost:4000
# ID_SERVICE_TIMEOUT_MS=2000

# The order-service's bearer for /internal/v1/payments; must equal its PAYMENT_SERVICE_TOKEN. The
# service refuses to boot without it.
INTERNAL_CALLER_TOKEN_ORDER_SERVICE=dev-only-order-to-payment-token-change-me-openssl
# INTERNAL_CALLER_TOKEN_ORDER_SERVICE_PREVIOUS=

# Attempts are stamped on every payment.authorized job; only the order-service's worker reads the
# cap. Keep both equal to the order-service's (its code defaults).
# ORDER_PAID_CONSUMER_ATTEMPTS=15
# ORDER_PAID_CONSUMER_BACKOFF_CAP_MS=300000

# PAYMENT_PROVIDER=stripe
# Min 16 chars; the Stripe adapter refuses to construct without it. `openssl rand -hex 24`.
PAYMENT_WEBHOOK_SECRET=whsec_dev_only_change_me_openssl_rand_hex_24
# PAYMENT_WEBHOOK_TOLERANCE_SEC=300
# Unset in development keeps the network-free path (fabricated cs_... sessions). Production refuses
# to boot without the key and the success URL. Use a sk_test_ key only, never commit it.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_SUCCESS_URL=http://localhost:3000/payments/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=http://localhost:3000/payments/cancel
# System test only, never deployed: points the SDK at the fake Stripe. Refused unless the key is sk_test_,
# in every NODE_ENV; http needs a host.
# STRIPE_API_HOST=fake-stripe
# STRIPE_API_PORT=12111
# STRIPE_API_PROTOCOL=http
# PAYMENT_SESSION_MIN_TTL_SEC=1800
# PAYMENT_SESSION_EXPIRY_MARGIN_SEC=120
# PAYMENT_CAPTURE_TIMEOUT_MS=10000

# OUTBOX_RELAY_ENABLED=true
# RECONCILE_ENABLED=true
# RECONCILE_INTERVAL_MS=60000
# RETENTION_WEBHOOK_EVENT_DAYS=30
