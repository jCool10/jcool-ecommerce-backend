# Copy to apps/inventory-service/.env. Read by `pnpm start` and the scripts; compose's inventory-service
# overrides the URLs below with in-network ones.
NODE_ENV=development
PORT=3004
LOG_LEVEL=info

# Its own database: compose's inventory-postgres, published on loopback.
DATABASE_URL=postgresql://inventory:inventory@localhost:5435/inventory
# The api's Redis, where the user-service publishes auth:epoch:* and auth:denylist:*.
REDIS_URL=redis://localhost:6380
# The gateway's internal load balancer, never a replica.
ID_SERVICE_URL=http://localhost:4000
# ID_SERVICE_TIMEOUT_MS=2000

# The user-service, which signs the admin tokens and answers an epoch missing from Redis.
AUTH_JWKS_URL=http://localhost:3002/.well-known/jwks.json
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=jcool-api
USER_SERVICE_URL=http://localhost:3002
# Must equal the user-service's INTERNAL_CALLER_TOKEN_INVENTORY_SERVICE.
USER_SERVICE_TOKEN=dev-only-inventory-caller-token-change-me-openssl

# The api's bearer for /internal/v1/reservations; must equal the api's INVENTORY_SERVICE_TOKEN.
INTERNAL_CALLER_TOKEN_API=dev-only-api-to-inventory-token-change-me-openssl
# INTERNAL_CALLER_TOKEN_API_PREVIOUS=

# The public catalog the stock seed walks, through the gateway.
CATALOG_PUBLIC_URL=http://localhost:8080

# INVENTORY_LOCK_STRATEGY=pessimistic
# Keep it below the api's CHECKOUT_TRY_TIMEOUT_MS (3000): the api gives up on a Try after that long.
# INVENTORY_TRY_LOCK_TIMEOUT_MS=2000
# INVENTORY_HOLD_SWEEP_ENABLED=true
THROTTLE_ENABLED=true
