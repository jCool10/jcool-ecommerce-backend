{
  "name": "@jcool/inventory-service",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Owns stock levels and the checkout's TCC holds; serves /internal/v1/reservations and /admin/inventory",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --import ./dist/instrumentation.js dist/main.js",
    "dev": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "arch:check": "depcruise --config .dependency-cruiser.cjs src",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./test/vitest-e2e.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/database/migrate-cli.js",
    "db:seed": "node --env-file-if-exists=.env dist/database/seed-stock.js"
  },
  "dependencies": {
    "@jcool/auth-verifier": "workspace:*",
    "@jcool/id-codec": "workspace:*",
    "@jcool/internal-contracts": "workspace:*",
    "@jcool/kernel": "workspace:*",
    "@jcool/metrics-port": "workspace:*",
    "@jcool/platform": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/nestjs": "^10.73.0",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-cls": "^6.2.2",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jcool/id-generator": "workspace:*",
    "@jcool/testing": "workspace:*",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "testcontainers": "^12.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^5.0.3"
  }
}
